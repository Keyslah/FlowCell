{
  "schemaVersion": 1,
  "id": "fusion-360.scale",
  "version": "1.2.0",
  "label": "Scale",
  "tooltip": "Smart Axis scaling: Base stores bounds, X/Y/Z cycle the locked side, Live updates while you drag the X/Y/Z sliders.",
  "kind": "toolset",
  "program": "Fusion 360",
  "source": "scale.py",
  "bridgeData": {},
  "stateQuery": {
    "slot": "cycle_x",
    "payload": {
      "action": "status",
      "command": "status"
    }
  },
  "children": [
    {
      "slot": "baseline",
      "label": "Base",
      "tooltip": "Store the selected bodies' bounds; locked sides hold these edges while scaling.",
      "payload": {
        "command": "baseline",
        "action": "baseline"
      }
    },
    {
      "slot": "cycle_x",
      "label": "X",
      "tooltip": "Cycle X between no lock (center), X- (Min side fixed), and X+ (Max side fixed).",
      "payload": {
        "command": "cycle_x",
        "action": "cycle_x"
      }
    },
    {
      "slot": "cycle_y",
      "label": "Y",
      "tooltip": "Cycle Y between no lock (center), Y- (Min side fixed), and Y+ (Max side fixed).",
      "payload": {
        "command": "cycle_y",
        "action": "cycle_y"
      }
    },
    {
      "slot": "cycle_z",
      "label": "Z",
      "tooltip": "Cycle Z between no lock (center), Z- (Min side fixed, e.g. the bottom), and Z+ (Max side fixed).",
      "payload": {
        "command": "cycle_z",
        "action": "cycle_z"
      }
    },
    {
      "slot": "toggle_live",
      "label": "Live",
      "tooltip": "Live on: sliders update Fusion while you drag. Live off: the drag applies when you let go.",
      "payload": {
        "command": "toggle_live",
        "action": "toggle_live"
      }
    },
    {
      "slot": "refresh",
      "label": "Refresh",
      "tooltip": "Read the selected bodies' sizes and reset the sliders to 100%.",
      "payload": {
        "command": "refresh",
        "action": "refresh"
      }
    },
    {
      "slot": "link_x_button",
      "label": "Link X",
      "tooltip": "While lit, dragging any lit slider moves the X slider with it."
    },
    {
      "slot": "link_y_button",
      "label": "Link Y",
      "tooltip": "While lit, dragging any lit slider moves the Y slider with it."
    },
    {
      "slot": "link_z_button",
      "label": "Link Z",
      "tooltip": "While lit, dragging any lit slider moves the Z slider with it."
    }
  ],
  "layout": {
    "mode": "grid",
    "width": 628,
    "height": 186,
    "placements": {
      "baseline": {
        "x": 8,
        "y": 8,
        "width": 80,
        "height": 42
      },
      "cycle_x": {
        "x": 96,
        "y": 8,
        "width": 80,
