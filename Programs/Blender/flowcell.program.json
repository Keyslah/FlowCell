{
  "schemaVersion": 1,
  "programId": "blender",
  "label": "Blender",
  "programType": "bridge",
  "defaultPanels": ["Collections", "Files", "Utility"],
  "panels": [
    { "id": "collections", "label": "Collections", "defaultSelected": true },
    { "id": "files", "label": "Files", "defaultSelected": true },
    { "id": "utility", "label": "Utility", "defaultSelected": true },
    { "id": "toolset", "label": "toolset", "defaultSelected": false }
  ],
  "processNames": ["blender", "blender-launcher"],
  "bindScopedNativeOwner": false,
  "shortcutProfileId": "blender.windows",
  "gitScriptsFolder": "Blender Git Scripts",
  "panelsFolder": "Panels",
  "localScriptsFolder": "Blender Local Scripts",
  "supportScriptsFolder": "SupportScripts",
  "allowedScriptExtensions": ["py"],
  "allowedManifestFileNames": ["flowcell.script.json", "flowcell.toolset.json"],
  "supportsToolsetManifests": true,
  "bundledSources": [
    {
      "id": "blender.save-blender",
      "version": "1.2.0",
      "panelName": "Files",
      "sourcePath": "Blender Git Scripts/Files/Save Blender",
      "importKind": "script",
      "displayLabel": "Save Blender",
      "sourceKind": "page",
      "required": false,
      "dependencies": [],
      "installEffects": ["Installs the Blender-owned Save Blender page Button into Files."],
      "installIfMissing": true,
      "installOnAdd": true,
      "legacyMatchLabel": "Save Blender",
      "legacyMatchKind": "script"
    },
    {
      "id": "blender.orca",
      "version": "1.0.1",
      "panelName": "Files",
      "sourcePath": "Blender Git Scripts/Files/orca.py",
      "importKind": "script",
      "displayLabel": "orca",
      "sourceKind": "script",
      "required": false,
      "dependencies": [],
      "installEffects": ["Installs the Blender OrcaSlicer export-and-launch Button into Files."],
      "installOnAdd": true,
      "legacyMatchLabel": "orca",
      "legacyMatchKind": "script"
    },
    {
      "id": "blender.cura",
      "version": "1.0.0",
      "panelName": "Files",
      "sourcePath": "Blender Git Scripts/Files/cura.py",
      "importKind": "script",
      "displayLabel": "cura",
      "sourceKind": "script",
      "required": false,
      "dependencies": [],
      "installEffects": ["Installs the Blender Cura export-and-launch Button into Files."],
      "installOnAdd": true,
      "legacyMatchLabel": "cura",
      "legacyMatchKind": "script"
    },
    {
      "id": "blender.slicer",
      "version": "1.0.1",
      "panelName": "Files",
      "sourcePath": "Blender Git Scripts/Files/slicer.py",
      "importKind": "script",
      "displayLabel": "slicer",
      "sourceKind": "script",
      "required": false,
      "dependencies": [],
      "installEffects": ["Installs the Blender configurable slicer export-and-launch Button into Files."],
      "installOnAdd": true,
      "legacyMatchLabel": "slicer",
      "legacyMatchKind": "script"
    },
    {
      "id": "blender.theme",
      "version": "3.0.0",
      "panelName": "toolset",
      "sourcePath": "Blender Git Scripts/Toolsets/theme",
      "importKind": "script",
      "displayLabel": "Theme",
      "sourceKind": "page",
      "required": false,
      "dependencies": [],
      "installEffects": ["Installs the Blender Theme page Button and its package-owned actions into the selected panel."],
      "installOnAdd": true,
      "legacyMatchLabel": "Theme",
      "legacyMatchKind": "script"
    }
  ],
  "runner": {
    "kind": "blender-bridge",
    "programKey": "blender_bridge",
    "installScript": "Install-BlenderFlowCellButtons.ps1",
    "deleteScript": "Remove-BlenderFlowCellButton.ps1"
  },
  "addonReloadNotes": "Reload the FlowCell Blender add-on or restart Blender after bridge deployment changes.",
  "appRestartNotes": "Restart FlowCell after changing this program manifest."
}
