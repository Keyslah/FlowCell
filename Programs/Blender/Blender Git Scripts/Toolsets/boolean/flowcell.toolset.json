{
    "schemaVersion": 1,
    "id": "blender.boolean",
    "version": "1.1.0",
    "label": "boolean",
    "tooltip": "Quick Boolean with I/U/D operation buttons, one cycling solver button, SI/HT/HC/S toggles, and Run.",
    "kind": "toolset",
    "program": "Blender",
    "source": "boolean.py",
    "bridgeData": {},
    "children": [
        {
            "slot": "operation_intersect",
            "label": "I",
            "tooltip": "Set the boolean operation to Intersect.",
            "payload": {
                "command": "operation_intersect",
                "action": "operation_intersect"
            }
        },
        {
            "slot": "operation_union",
            "label": "U",
            "tooltip": "Set the boolean operation to Union.",
            "payload": {
                "command": "operation_union",
                "action": "operation_union"
            }
        },
        {
            "slot": "operation_difference",
            "label": "D",
            "tooltip": "Set the boolean operation to Difference.",
            "payload": {
                "command": "operation_difference",
                "action": "operation_difference"
            }
        },
        {
            "slot": "solver_cycle",
            "label": "Exact",
            "tooltip": "Cycle the boolean solver between Exact, Float, and Manifold.",
            "payload": {
                "command": "cycle_solver",
                "action": "cycle_solver"
            }
        },
        {
            "slot": "toggle_self_intersection",
            "label": "SI",
            "tooltip": "Toggle self-intersection support.",
            "payload": {
                "command": "toggle_self_intersection",
                "action": "toggle_self_intersection"
            }
        },
        {
            "slot": "toggle_hole_tolerant",
            "label": "HT",
            "tooltip": "Toggle hole-tolerant solving.",
            "payload": {
                "command": "toggle_hole_tolerant",
                "action": "toggle_hole_tolerant"
            }
        },
        {
            "slot": "toggle_hide_cutter",
            "label": "HC",
            "tooltip": "Toggle hiding the cutter after running.",
            "payload": {
                "command": "toggle_hide_cutter",
                "action": "toggle_hide_cutter"
            }
        },
        {
            "slot": "toggle_backup_active",
            "label": "S",
            "tooltip": "Toggle taking a FlowCell snapshot before running.",
            "payload": {
                "command": "toggle_backup_active",
                "action": "toggle_backup_active"
            }
        },
        {
            "slot": "run_boolean",
            "label": "Run",
            "tooltip": "Run the quick boolean operation.",
            "payload": {
                "command": "run_boolean",
                "action": "run_boolean"
            }
        }
