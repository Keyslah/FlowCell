{
  "schemaVersion": 1,
  "id": "blender.tri-poly",
  "version": "1.1.3",
  "label": "tri poly",
  "tooltip": "Create triangle and regular polygon prism shapes from a compact Tri & Poly tool set.",
  "kind": "toolset",
  "program": "Blender",
  "source": "tri poly.py",
  "bridgeData": {},
  "children": [
    {
      "slot": "triangle_equilateral",
      "label": "Equal ",
      "tooltip": "Create an equilateral triangular prism.",
      "payload": {
        "command": "triangle_equilateral",
        "action": "triangle_equilateral"
      }
    },
    {
      "slot": "triangle_isosceles",
      "label": "Isosceles ",
      "tooltip": "Create an isosceles triangular prism.",
      "payload": {
        "command": "triangle_isosceles",
        "action": "triangle_isosceles"
      }
    },
    {
      "slot": "triangle_50",
      "label": "Angle",
      "tooltip": "Create a triangular prism with the typed apex angle.",
      "payload": {
        "command": "triangle_50",
        "action": "triangle_50"
      }
    },
    {
      "slot": "triangle_right",
      "label": "Right",
      "tooltip": "Create a right triangular prism.",
      "payload": {
        "command": "triangle_right",
        "action": "triangle_right"
      }
    },
    {
      "slot": "triangle_scalene",
      "label": "Scalene",
      "tooltip": "Create a scalene triangular prism.",
      "payload": {
        "command": "triangle_scalene",
        "action": "triangle_scalene"
      }
    },
    {
      "slot": "polygon_create",
      "label": "Create",
      "tooltip": "Create a regular polygon prism using the staged side count.",
      "payload": {
        "command": "polygon_create",
        "action": "polygon_create"
      }
    },
    {
      "slot": "angle_input",
      "label": "50",
      "tooltip": "Click anywhere on this Button, then type the triangular prism apex angle."
    },
    {
      "slot": "sides_input",
      "label": "15",
      "tooltip": "Click anywhere on this Button, then type the regular polygon side count."
    }
  ],
