{
    "schemaVersion": 1,
    "id": "blender.remesh",
    "version": "1.1.2",
    "label": "remesh",
    "tooltip": "Remesh with one cycling mode Button, inline-editable value Buttons, SS/RD toggles, Create, and Apply.",
    "kind": "toolset",
    "program": "Blender",
    "source": "remesh.py",
    "bridgeData": {},
    "children": [
        {
            "slot": "mode_cycle",
            "label": "Voxel",
            "tooltip": "Cycle the remesh mode between Voxel, Smooth, Sharp, and Blocks.",
            "payload": {
                "command": "cycle_mode",
                "action": "cycle_mode"
            }
        },
        {
            "slot": "set_voxel_size_mm",
            "label": "0.10",
            "tooltip": "Click this Button, then type the voxel size in millimeters."
        },
        {
            "slot": "set_adaptivity",
            "label": "0.00",
            "tooltip": "Click this Button, then type the voxel adaptivity."
        },
        {
            "slot": "set_octree_depth",
            "label": "6",
            "tooltip": "Click this Button, then type the octree depth."
        },
        {
            "slot": "set_scale",
            "label": "0.90",
            "tooltip": "Click this Button, then type the block scale."
        },
        {
            "slot": "set_threshold",
            "label": "0.10",
            "tooltip": "Click this Button, then type the sharp threshold."
        },
        {
            "slot": "set_sharpness",
            "label": "1.00",
            "tooltip": "Click this Button, then type the sharpness."
        },
        {
            "slot": "toggle_smooth_shading",
            "label": "SS",
            "tooltip": "Toggle smooth shading on the remesh result.",
            "payload": {
                "command": "toggle_smooth_shading",
                "action": "toggle_smooth_shading"
            }
        },
        {
            "slot": "toggle_remove_disconnected",
            "label": "RD",
            "tooltip": "Toggle removing disconnected geometry.",
            "payload": {
                "command": "toggle_remove_disconnected",
                "action": "toggle_remove_disconnected"
            }
        },
        {
            "slot": "create_update_remesh",
            "label": "Create",
            "tooltip": "Create or update the Remesh modifier with the current values.",
            "payload": {
                "command": "create_update_remesh",
                "action": "create_update_remesh"
            }
        },
        {
            "slot": "apply_remesh",
            "label": "Apply",
            "tooltip": "Apply the Remesh modifier with the current values.",
            "payload": {
                "command": "apply_remesh",
                "action": "apply_remesh"
            }
        }
    ],
