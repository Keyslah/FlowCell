{
  "schemaVersion": 1,
  "id": "blender.flatten-revolve",
  "version": "1.1.4",
  "label": "flat",
  "tooltip": "Flatten the active mesh into a centered profile, hide the source object, and revolve the profile in place.",
  "kind": "toolset",
  "program": "Blender",
  "source": "flatten revolve.py",
  "bridgeData": {},
  "children": [
    {
      "slot": "pivot_select",
      "label": "World",
      "tooltip": "Choose the shared pivot used by Flatten and Revolve."
    },
    {
      "slot": "flatten_profile",
      "label": "Flatten",
      "tooltip": "Flatten the active mesh into a centered profile using the current field values.",
      "payload": {
        "command": "flatten_profile",
        "action": "flatten_profile"
      }
    },
    {
      "slot": "flatten_axis_select",
      "label": "Y",
      "tooltip": "Choose the axis collapsed by Flatten."
    },
    {
      "slot": "generate_revolve",
      "label": "Revolve",
      "tooltip": "Generate revolve geometry from the current flattened profile and field values.",
      "payload": {
        "command": "generate_revolve",
        "action": "generate_revolve"
      }
    },
    {
      "slot": "revolve_axis_select",
      "label": "Z",
      "tooltip": "Choose the axis used by Revolve."
    },
    {
      "slot": "angle_input",
      "label": "360",
      "tooltip": "Click anywhere on this Button, then type the revolve angle in degrees."
    },
    {
      "slot": "steps_input",
      "label": "128",
      "tooltip": "Click anywhere on this Button, then type the number of revolve steps."
    },
    {
      "slot": "merge_input",
      "label": "0.0001",
      "tooltip": "Click anywhere on this Button, then type the revolve merge distance."
    }
  ],
  "layout": {
    "mode": "grid",
    "columns": 5,
    "gap": 8,
    "padding": 8,
    "width": 640,
