{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowCell Illustrator actions",
  "type": "object",
  "required": ["version", "actions"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "script"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "buttonSource": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
