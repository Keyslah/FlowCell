                if (!bounds) {
                    bounds = { left: left, right: right, top: top, bottom: bottom };
                } else {
                    bounds.left = Math.min(bounds.left, left);
                    bounds.right = Math.max(bounds.right, right);
                    bounds.top = Math.max(bounds.top, top);
                    bounds.bottom = Math.min(bounds.bottom, bottom);
                }
            }
        } catch (ignored) {
            return null;
        }
        if (!bounds) {
            return null;
        }
        return {
            x: (bounds.left + bounds.right) / 2,
            y: (bounds.top + bounds.bottom) / 2,
            source: "SELECTION"
        };
    }

    function resolveCenter(doc, state) {
        var key = getDocumentKey(doc);
        if (state.center && state.center.documentKey === key &&
                isFinite(Number(state.center.x)) && isFinite(Number(state.center.y))) {
            return {
                x: Number(state.center.x),
                y: Number(state.center.y),
                source: String(state.center.source || "STORED")
            };
        }
        return activeArtboardCenter(doc);
    }

    function rememberEligibleSources(state, doc, records) {
        var knownSources = {};
        records = records || eligibleSourceRecords(doc);
        for (var i = 0; i < records.length; i += 1) {
            knownSources[records[i].uuid] = records[i].fingerprint;
        }
        state.documentKey = getDocumentKey(doc);
        state.knownSources = knownSources;
        return records;
    }

    function baselineEligiblePaths(state, doc) {
        rememberEligibleSources(state, doc);
        state.lastSourceUuid = "";
        state.lastSourceFingerprint = "";
        state.lastCopyCount = 0;
    }

    function changedSourceResult(doc, state) {
        var records = eligibleSourceRecords(doc);
        var changed = [];
        var i;
        for (i = 0; i < records.length; i += 1) {
            if (state.knownSources[records[i].uuid] !== records[i].fingerprint) {
                changed.push(records[i]);
            }
        }
        if (changed.length < 1) {
            return { record: null, records: records, reason: "no-change" };
        }

        var selected = [];
        try {
            for (i = 0; i < doc.selection.length; i += 1) {
                var selectedUuid = sourceUuid(doc.selection[i]);
                for (var changedIndex = 0; changedIndex < changed.length; changedIndex += 1) {
                    if (selectedUuid && changed[changedIndex].uuid === selectedUuid) {
                        selected.push(changed[changedIndex]);
                        break;
                    }
                }
            }
        } catch (ignoredSelection) {
        }
        if (selected.length === 1) {
            return { record: selected[0], records: records, reason: "selected-change" };
        }
        if (changed.length === 1) {
            return { record: changed[0], records: records, reason: "single-change" };
        }
        return { record: null, records: records, reason: "ambiguous-change" };
    }

    function rotationMatrixAbout(center, angleDegrees) {
        var matrix = app.getRotationMatrix(angleDegrees);
        matrix.mValueTX = center.x - (matrix.mValueA * center.x + matrix.mValueC * center.y);
        matrix.mValueTY = center.y - (matrix.mValueB * center.x + matrix.mValueD * center.y);
        return matrix;
    }

    function mirrorMatrixAbout(center) {
        var matrix = app.getScaleMatrix(-100, 100);
        matrix.mValueTX = center.x - (matrix.mValueA * center.x + matrix.mValueC * center.y);
        matrix.mValueTY = center.y - (matrix.mValueB * center.x + matrix.mValueD * center.y);
        return matrix;
    }

    function transformItem(item, matrix) {
        item.transform(
            matrix,
            true,
            true,
            true,
            true,
            100,
            Transformation.DOCUMENTORIGIN
        );
    }

    function markCopy(copy, sourceUuid, index) {
        setTagValue(copy, COPY_TAG_NAME, sourceUuid + "|" + String(index));
        try {
            copy.selected = false;
        } catch (ignored) {
        }
    }

    function removeCopiesForSource(doc, sourceUuid) {
        var prefix = sourceUuid + "|";
        var removed = 0;
        for (var i = doc.pathItems.length - 1; i >= 0; i -= 1) {
            var item = doc.pathItems[i];
            var tagValue = getTagValue(item, COPY_TAG_NAME);
            if (tagValue.indexOf(prefix) === 0) {
                try {
                    item.remove();
                    removed += 1;
                } catch (ignored) {
                }
            }
        }
        return removed;
    }

    function createRadialCopies(source, center, count) {
        var created = 0;
        var step = 360 / count;
        for (var i = 1; i < count; i += 1) {
            var copy = source.duplicate();
            transformItem(copy, rotationMatrixAbout(center, step * i));
            markCopy(copy, String(source.uuid), i);
            created += 1;
        }
        return created;
    }

    function createMirrorCopies(source, center, count) {
        var pairCount = count / 2;
        var step = 360 / pairCount;
        var created = 0;
        var copyIndex = 1;

        for (var pairIndex = 0; pairIndex < pairCount; pairIndex += 1) {
            var angle = step * pairIndex;
            if (pairIndex > 0) {
                var rotated = source.duplicate();
                transformItem(rotated, rotationMatrixAbout(center, angle));
                markCopy(rotated, String(source.uuid), copyIndex);
                copyIndex += 1;
                created += 1;
            }

            var mirrored = source.duplicate();
            transformItem(mirrored, mirrorMatrixAbout(center));
            if (angle !== 0) {
                transformItem(mirrored, rotationMatrixAbout(center, angle));
            }
            markCopy(mirrored, String(source.uuid), copyIndex);
            copyIndex += 1;
            created += 1;
        }
        return created;
    }

    function processPress() {
        var state = readState();
        if (!state.enabled) {
            return "disabled";
        }

        var doc = getActiveDocument();
        if (!doc) {
            return "no-document";
        }

        var key = getDocumentKey(doc);
        if (state.documentKey !== key) {
            baselineEligiblePaths(state, doc);
            saveState(state);
            return "document-baseline";
        }

        return "ready";
    }

    function processRelease() {
        var state = readState();
        if (!state.enabled) {
            return "disabled";
        }

        var doc = getActiveDocument();
        if (!doc) {
            return "no-document";
        }

        var key = getDocumentKey(doc);
        if (state.documentKey !== key) {
            baselineEligiblePaths(state, doc);
            saveState(state);
            return "document-baseline";
        }

        var changed = changedSourceResult(doc, state);
        if (!changed.record) {
            if (changed.reason === "ambiguous-change") {
                baselineEligiblePaths(state, doc);
                saveState(state);
                setStatus("Symmetry skipped an ambiguous multi-path change to avoid modifying unrelated artwork.", true);
                return "ambiguous-change";
            }
            return changed.reason;
        }

        var source = changed.record.item;
        var sourceId = changed.record.uuid;
        var fingerprint = changed.record.fingerprint;
        removeCopiesForSource(doc, sourceId);
        var center = resolveCenter(doc, state);
        var created = state.mode === "MIRROR"
            ? createMirrorCopies(source, center, state.count)
            : createRadialCopies(source, center, state.count);

        rememberEligibleSources(state, doc);
        state.lastSourceUuid = sourceId;
        state.lastSourceFingerprint = fingerprint;
        state.lastCopyCount = created;
