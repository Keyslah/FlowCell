        state.lastProcessedAtMs = nowMs();
        saveState(state);

        try {
            source.selected = true;
        } catch (ignoredSelection) {
        }

        try {
            app.redraw();
        } catch (ignored) {
        }

        setStatus(
            "Symmetry created " + created + " copy/copies in " + state.mode +
                " mode around the " + center.source.toLowerCase() + " center.",
            true
        );
        return "processed|" + sourceId + "|" + String(created);
    }

    function readCommand() {
        var commandFile = new File(runtimeFolder().fsName + "/" + COMMAND_FILE_NAME);
        var raw = readTextFile(commandFile);
        if (!raw) {
            return { command: "status", payload: {} };
        }
        try {
            commandFile.remove();
        } catch (ignoredRemove) {
        }

        var record;
        try {
            record = eval("(" + raw + ")");
        } catch (error) {
            throw new Error("Symmetry command JSON is invalid: " + String(error));
        }
        if (!record || String(record.ownerButtonId || "").toLowerCase() !== String(ownerFolder().name || "").toLowerCase() ||
                normalizedPath(record.sourcePath) !== normalizedPath(sourceFile().fsName)) {
            throw new Error("Symmetry command does not belong to this installed Button owner.");
        }
        var commandName = String(record.command || "status").toLowerCase();
        if (commandName !== "status") {
            var createdAtMs = Number(record.createdAtMs);
            if (typeof record.createdAtMs !== "number" || !isFinite(createdAtMs) ||
                    createdAtMs <= 0 || createdAtMs > nowMs() + MAX_COMMAND_AGE_MS ||
                    nowMs() - createdAtMs > MAX_COMMAND_AGE_MS) {
                throw new Error("Stale or malformed Symmetry command ignored.");
            }
        }
        return {
            command: record && record.command ? String(record.command) : "status",
            payload: record && record.payload ? record.payload : {}
        };
    }

    function normalizedPath(value) {
        var normalized = String(value || "").replace(/\//g, "\\").replace(/\\+$/, "").toLowerCase();
        if (normalized.indexOf("\\\\?\\unc\\") === 0) {
            normalized = "\\\\" + normalized.substring(8);
        } else if (normalized.indexOf("\\\\?\\") === 0) {
            normalized = normalized.substring(4);
        }
        return normalized;
    }

    function applyPayloadSettings(state, payload) {
        if (payload && typeof payload.enabled !== "undefined") {
            if (typeof payload.enabled !== "boolean") {
                throw new Error("Symmetry enabled must be true or false.");
            }
            state.enabled = payload.enabled === true;
        }
        if (payload && typeof payload.mode !== "undefined") {
            var mode = normalizeMode(payload.mode);
            if (!mode) {
                throw new Error("Unsupported Symmetry mode. Use MIRROR or RADIAL.");
            }
            state.mode = mode;
        }
        if (payload && typeof payload.count !== "undefined") {
            var count = normalizeCount(payload.count);
            if (!count) {
                throw new Error("Unsupported Symmetry count. Use 2, 4, 6, 8, or 12.");
            }
            state.count = count;
        }
    }

    function launchWatcher() {
        var launcher = new File(sourceFolder().fsName + "/" + WATCHER_LAUNCHER_FILE_NAME);
        if (!launcher.exists) {
            throw new Error("Symmetry watcher launcher is missing: " + launcher.fsName);
        }
        if (!launcher.execute()) {
            throw new Error("Windows did not start the Symmetry watcher launcher.");
        }
    }

    function configure(payload) {
        var state = readState();
        var wasEnabled = state.enabled;
        applyPayloadSettings(state, payload);

        var doc = getActiveDocument();
        if (state.enabled && doc && (!wasEnabled || state.documentKey !== getDocumentKey(doc))) {
            baselineEligiblePaths(state, doc);
        }
        saveState(state);

        if (state.enabled) {
            launchWatcher();
        }

        return setStatus(
            "Symmetry " + (state.enabled ? "ON" : "OFF") +
                " | " + state.mode + " | " + state.count + " total positions.",
            true
        );
    }

    function setCenter(payload) {
        var state = readState();
        applyPayloadSettings(state, payload);
        var doc = getActiveDocument();
        if (!doc) {
            throw new Error("Open an Illustrator document before setting the Symmetry center.");
        }

        var center = selectionCenter(doc);
        if (!center) {
            center = activeArtboardCenter(doc);
        }
        center.documentKey = getDocumentKey(doc);
        state.center = center;
        if (state.documentKey !== center.documentKey) {
            baselineEligiblePaths(state, doc);
        }
        saveState(state);

        if (state.enabled) {
            launchWatcher();
        }

        return setStatus(
            "Symmetry center set from " + center.source.toLowerCase() +
                " at X " + fixedNumber(center.x) + ", Y " + fixedNumber(center.y) + ".",
            true
        );
    }

    function status() {
        var state = readState();
        return setStatus(
            "Symmetry " + (state.enabled ? "ON" : "OFF") +
                " | " + state.mode + " | " + state.count + " total positions.",
            false
        );
    }

    function runToolsetCommand() {
        var record = readCommand();
        var payload = record.payload || {};
        var command = payload.command ? String(payload.command).toLowerCase() : String(record.command || "status").toLowerCase();

        if (command === "enable") {
            payload.enabled = true;
            command = "configure";
        } else if (command === "disable") {
            payload.enabled = false;
            command = "configure";
        } else if (command === "mode_mirror") {
            payload.mode = "MIRROR";
            command = "configure";
        } else if (command === "mode_radial") {
            payload.mode = "RADIAL";
            command = "configure";
        } else if (command.indexOf("count_") === 0) {
            payload.count = Number(command.substring(6));
            command = "configure";
        }

        if (command === "configure") {
            return configure(payload);
        }
        if (command === "set_center") {
            return setCenter(payload);
        }
        if (command === "status") {
            return status();
        }
        throw new Error("Unsupported Illustrator Symmetry command: " + command);
    }

    function publishTestApi() {
        return {
            COPY_TAG_NAME: COPY_TAG_NAME,
            normalizeMode: normalizeMode,
            normalizeCount: normalizeCount,
            sourceFile: sourceFile,
            sourceFolder: sourceFolder,
            ownerFolder: ownerFolder,
            runtimeFolder: runtimeFolder,
            getDocumentKey: getDocumentKey,
            readState: readState,
            saveState: saveState,
            configure: configure,
            processPress: processPress,
            processRelease: processRelease,
            eligibleSourceRecords: eligibleSourceRecords,
            changedSourceResult: changedSourceResult,
            createRadialCopies: createRadialCopies,
            createMirrorCopies: createMirrorCopies,
            readCommand: readCommand
        };
    }

    try {
        if (typeof $ !== "undefined" && $.global && $.global.__FLOWCELL_ILLUSTRATOR_SYMMETRY_TEST__ === true) {
            $.global.__FLOWCELL_ILLUSTRATOR_SYMMETRY_TEST_API__ = publishTestApi();
            return $.global.__FLOWCELL_ILLUSTRATOR_SYMMETRY_TEST_API__;
        }
    } catch (ignoredTestMode) {
    }

    try {
        if (typeof FLOWCELL_ARGS !== "undefined" && FLOWCELL_ARGS) {
            var internalCommand = String(FLOWCELL_ARGS.internalCommand || "").toLowerCase();
            if (internalCommand === "process_press") {
                return processPress();
            }
            if (internalCommand === "process_release") {
                return processRelease();
            }
        }
        return runToolsetCommand();
    } catch (error) {
        var message = "Illustrator Symmetry failed: " + String(error && error.message ? error.message : error);
        setStatus(message, true);
        throw error;
    }
}());
