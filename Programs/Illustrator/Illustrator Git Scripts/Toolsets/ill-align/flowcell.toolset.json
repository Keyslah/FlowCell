{
  "schemaVersion": 1,
  "id": "illustrator.ill-align",
  "version": "1.0.1",
  "label": "Ill Align",
  "tooltip": "Align Illustrator selections to the FlowCell anchor or active artboard.",
  "kind": "toolset",
  "program": "Illustrator",
  "source": "Ill Align.jsx",
  "execution": {
    "programKey": "illustrator_process",
    "commandFile": "illustrator_anchor_command.json"
  },
  "children": [
    { "slot": "x_min", "label": "X Min", "tooltip": "Align the selected object's matching X edge or center-point origin to the anchor minimum.", "payload": { "command": "align_axis", "axis": "X", "mode": "MIN", "modifier": "" } },
    { "slot": "x_center", "label": "X Center", "tooltip": "Align horizontal centers to the anchor.", "payload": { "command": "align_axis", "axis": "X", "mode": "CENTER", "modifier": "" } },
    { "slot": "x_max", "label": "X Max", "tooltip": "Align the selected object's matching X edge or center-point origin to the anchor maximum.", "payload": { "command": "align_axis", "axis": "X", "mode": "MAX", "modifier": "" } },
    { "slot": "x_surface", "label": "X Surface", "tooltip": "Move to the opposite outside X surface of the anchor; repeated presses toggle between X Min and X Max surfaces.", "payload": { "command": "align_axis", "axis": "X", "mode": "CENTER", "modifier": "SURFACE" } },
    { "slot": "x_geo", "label": "X Origin", "tooltip": "Toggle using the selected object's center point as its X origin.", "payload": { "command": "align_axis", "axis": "X", "mode": "CENTER", "modifier": "GEOCENTER" } },
    { "slot": "y_min", "label": "Y Min", "tooltip": "Align the selected object's matching Y edge or center-point origin to the anchor minimum.", "payload": { "command": "align_axis", "axis": "Y", "mode": "MIN", "modifier": "" } },
    { "slot": "y_center", "label": "Y Center", "tooltip": "Align vertical centers to the anchor.", "payload": { "command": "align_axis", "axis": "Y", "mode": "CENTER", "modifier": "" } },
    { "slot": "y_max", "label": "Y Max", "tooltip": "Align the selected object's matching Y edge or center-point origin to the anchor maximum.", "payload": { "command": "align_axis", "axis": "Y", "mode": "MAX", "modifier": "" } },
    { "slot": "y_surface", "label": "Y Surface", "tooltip": "Move to the opposite outside Y surface of the anchor; repeated presses toggle between Y Min and Y Max surfaces.", "payload": { "command": "align_axis", "axis": "Y", "mode": "CENTER", "modifier": "SURFACE" } },
    { "slot": "y_geo", "label": "Y Origin", "tooltip": "Toggle using the selected object's center point as its Y origin.", "payload": { "command": "align_axis", "axis": "Y", "mode": "CENTER", "modifier": "GEOCENTER" } },
    { "slot": "center_artboard", "label": "Art", "tooltip": "Center on the active artboard.", "payload": { "command": "center_artboard" } },
    { "slot": "center_everything", "label": "Anchor", "tooltip": "Center on the stored FlowCell anchor.", "payload": { "command": "center_all" } },
    { "slot": "toggle_group", "label": "Group", "tooltip": "Toggle moving the selection as one virtual group.", "payload": { "command": "status" } }
  ],
  "layout": {
    "mode": "grid",
    "columns": 5,
    "gap": 8,
    "padding": 8,
    "width": 620,
    "height": 236,
    "fields": [
      {
        "id": "x_origin_active",
        "kind": "toggle",
        "label": "X Origin active",
        "payloadKey": "",
        "defaultValue": false,
        "x": 8,
        "y": 8,
        "width": 120,
        "height": 36,
        "zIndex": 1,
        "hidden": true
      },
      {
        "id": "y_origin_active",
        "kind": "toggle",
        "label": "Y Origin active",
        "payloadKey": "",
        "defaultValue": false,
        "x": 8,
        "y": 8,
        "width": 120,
        "height": 36,
        "zIndex": 1,
        "hidden": true
      },
      {
        "id": "group",
        "kind": "toggle",
        "label": "Group selection",
        "payloadKey": "group",
        "defaultValue": false,
        "x": 8,
        "y": 188,
        "width": 180,
        "height": 36,
        "zIndex": 2,
        "hidden": true
      }
    ],
    "childBehaviors": {
      "x_min": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "X",
          "mode": "MIN",
          "modifier": {
            "origin": {
              "$field": "x_origin_active"
            }
          },
          "group": {
            "$field": "group"
          }
        }
      },
      "x_center": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "X",
          "mode": "CENTER",
          "modifier": "",
          "group": {
            "$field": "group"
          }
        }
      },
      "x_max": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "X",
          "mode": "MAX",
          "modifier": {
            "origin": {
              "$field": "x_origin_active"
            }
          },
          "group": {
            "$field": "group"
          }
        }
      },
      "x_surface": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "X",
          "mode": "CENTER",
          "modifier": "SURFACE",
          "group": {
            "$field": "group"
          }
        }
      },
      "x_geo": {
        "toggleFields": [
          "x_origin_active"
        ],
        "execute": false
      },
      "y_min": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "Y",
          "mode": "MIN",
          "modifier": {
            "origin": {
              "$field": "y_origin_active"
            }
          },
          "group": {
            "$field": "group"
          }
        }
      },
      "y_center": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "Y",
          "mode": "CENTER",
          "modifier": "",
          "group": {
            "$field": "group"
          }
        }
      },
      "y_max": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "Y",
          "mode": "MAX",
          "modifier": {
            "origin": {
              "$field": "y_origin_active"
            }
          },
          "group": {
            "$field": "group"
          }
        }
      },
      "y_surface": {
        "execute": true,
        "payloadTemplate": {
          "command": "align_axis",
          "axis": "Y",
          "mode": "CENTER",
          "modifier": "SURFACE",
          "group": {
            "$field": "group"
          }
        }
      },
      "y_geo": {
        "toggleFields": [
          "y_origin_active"
        ],
        "execute": false
      },
      "center_artboard": {
        "execute": true,
        "payloadTemplate": {
          "command": "center_artboard",
          "group": {
            "$field": "group"
          }
        }
      },
      "center_everything": {
        "execute": true,
        "payloadTemplate": {
          "command": "center_all",
          "group": {
            "$field": "group"
          }
        }
      },
      "toggle_group": {
        "toggleFields": [
          "group"
        ],
        "execute": false
      }
    },
    "placements": {
