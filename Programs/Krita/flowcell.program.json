{
  "schemaVersion": 1,
  "programId": "plain-krita",
  "label": "Krita",
  "programType": "local-script",
  "defaultPanels": [
    "Files",
    "Layers",
    "Brushes",
    "Toolbox",
    "Tools"
  ],
  "panels": [
    {
      "id": "files",
      "label": "Files",
      "defaultSelected": true
    },
    {
      "id": "layers",
      "label": "Layers",
      "defaultSelected": true
    },
    {
      "id": "brushes",
      "label": "Brushes",
      "defaultSelected": true
    },
    {
      "id": "toolbox",
      "label": "Toolbox",
      "defaultSelected": true
    },
    {
      "id": "tools",
      "label": "Tools",
      "defaultSelected": true
    }
  ],
  "processNames": [
    "krita",
    "KritaStencilPreview"
  ],
  "exePath": "C:\\Program Files\\Krita (x64)\\bin\\krita.exe",
  "bindScopedNativeOwner": false,
  "shortcutProfileId": "",
  "gitScriptsFolder": "Krita Git Scripts",
  "panelsFolder": "Panels",
  "localScriptsFolder": "Krita Local Scripts",
  "supportScriptsFolder": "SupportScripts",
  "allowedScriptExtensions": [
    "ps1",
    "cmd",
    "bat",
    "exe",
    "lnk",
    "vbs",
    "ahk"
