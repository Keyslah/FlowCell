{
  "schemaVersion": 1,
  "id": "windows.setup-organization",
  "label": "Setup Organization",
  "tooltip": "Build reusable Windows folder rules and install Buttons for saved organization profiles.",
  "program": "Windows",
  "source": "setup_organization.ps1",
  "page": {
    "schemaVersion": 1,
    "id": "windows.setup-organization",
    "program": "Windows",
    "label": "Setup Organization",
    "tooltip": "Scan any Windows folder, define reusable rules, apply saved profiles, and install profile Buttons.",
    "entry": "page/index.html",
    "scripts": [
      "page/page.js"
    ],
    "styles": [
      "page/page.css"
    ],
    "assets": [],
    "window": {
      "title": "Setup Organization",
      "width": 1080,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560
    },
    "actions": [
      {
        "id": "select-root",
        "handler": {
          "kind": "core",
          "capability": "folder.select",
          "options": {
            "dialogTitle": "Choose a Windows root to organize"
          }
        },
        "requestSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "responseSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected",
            "path"
          ],
          "properties": {
            "selected": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "scan-root",
        "handler": {
          "kind": "program",
          "capability": "windows.setup-organization",
          "payload": {
            "operation": "scan-root"
          }
        },
        "requestSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rootPath"
          ],
          "properties": {
            "rootPath": {
              "type": "string"
            }
          }
        },
        "responseSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rootPath",
            "folders",
            "files"
          ],
          "properties": {
            "rootPath": {
              "type": "string"
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relativePath",
                  "name"
                ],
                "properties": {
                  "relativePath": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relativePath",
                  "name",
                  "extension",
                  "size"
                ],
                "properties": {
                  "relativePath": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
      {
