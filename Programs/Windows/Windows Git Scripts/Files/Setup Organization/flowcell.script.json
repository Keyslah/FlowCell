                    "properties": {
                      "ruleId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "targetFolder": {
                        "type": "string"
                      },
                      "extensions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "nameContains": {
                        "type": "string"
                      },
                      "matchAll": {
                        "type": "boolean"
                      },
                      "enabled": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                }
              }
            }
          }
        }
