{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowcell.windows.setup-organization.profile.v1",
  "title": "FlowCell Windows Setup Organization Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "profileId",
    "name",
    "rules",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "flowcell.windows.setup-organization.profile.v1"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "name",
          "targetFolder",
          "extensions",
          "nameContains",
          "matchAll",
          "enabled"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,128}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetFolder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 520
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.[a-z0-9][a-z0-9._+-]*$",
              "maxLength": 32
            },
            "uniqueItems": true
          },
          "nameContains": {
            "type": "string",
            "maxLength": 120
          },
          "matchAll": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
