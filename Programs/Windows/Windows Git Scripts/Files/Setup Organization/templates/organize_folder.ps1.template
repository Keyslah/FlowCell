[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [string]$TargetPath = '',

    [Parameter()]
    [string]$PlannedExtension = ''
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# Generated by Setup Organization. This Button is bound to one saved profile at
# install time, so it works on the first press with no prompt. The profile lives
# in the shared Windows program-data namespace, not in this package: editing the
# profile changes what this Button does without reinstalling it.
$script:ProfileId = '{{PROFILE_ID}}'
$script:ProfileFormat = 'flowcell.windows.setup-organization.profile.v3'
$script:MarkerFormat = 'flowcell.project.v1'
$script:MarkerFileName = '.flowcell-project.json'
$script:JournalFormat = 'flowcell.windows.setup-organization.operation-journal.v1'
$script:LegacyArtifactNames = @('organize-folder.profile.json', 'organize-folder.undo.json')

function ConvertFrom-ExtendedWindowsPath {
    param([Parameter(Mandatory = $true)][string]$Path)

    if ($Path.StartsWith('\\?\UNC\', [System.StringComparison]::OrdinalIgnoreCase)) { return '\\' + $Path.Substring(8) }
    if ($Path.StartsWith('\\?\', [System.StringComparison]::OrdinalIgnoreCase)) { return $Path.Substring(4) }
    return $Path
}

function Resolve-FlowCellRoot {
    $current = ConvertFrom-ExtendedWindowsPath -Path ([System.IO.Path]::GetFullPath($PSScriptRoot))
    while (-not [string]::IsNullOrWhiteSpace($current)) {
        if ((Test-Path -LiteralPath (Join-Path $current 'flowcellbackend') -PathType Container) -and
            (Test-Path -LiteralPath (Join-Path $current 'Programs\Windows') -PathType Container)) {
            return $current
        }
        $parent = Split-Path -Parent $current
        if ([string]::IsNullOrWhiteSpace($parent) -or $parent -eq $current) { break }
        $current = $parent
    }
    throw 'Could not locate the FlowCell root from this Button.'
}

function Get-ProgramDataRoot {
    return Join-Path (Resolve-FlowCellRoot) 'flowcellbackend\local\program-data\windows\setup-organization'
}

function Assert-NotReparsePoint {
    param([Parameter(Mandatory = $true)][string]$Path, [Parameter(Mandatory = $true)][string]$Label)

    $item = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
    if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "$Label cannot be a symbolic link or reparse point: $Path"
    }
}

function Resolve-TargetFolder {
    <#
        The target comes from the Button argument when one is supplied, otherwise
        from the clipboard: either a copied folder (file drop list) or a copied
        path string.
    #>
    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$Argument)

    $candidate = $Argument.Trim().Trim('"')
    if ([string]::IsNullOrWhiteSpace($candidate)) {
        $fileDropList = $null
        try { $fileDropList = Get-Clipboard -Format FileDropList -ErrorAction Stop } catch { $fileDropList = $null }
        if ($null -ne $fileDropList) {
            if ($fileDropList -is [string]) {
                $candidate = [string]$fileDropList
            }
            else {
                foreach ($entry in $fileDropList) {
                    $value = ([string]$entry).Trim().Trim('"')
                    if ([string]::IsNullOrWhiteSpace($value)) { continue }
                    $candidate = $value
                    break
                }
            }
        }
        if ([string]::IsNullOrWhiteSpace($candidate)) {
            try { $candidate = ([string](Get-Clipboard -Format Text -ErrorAction Stop)).Trim().Trim('"') } catch { $candidate = '' }
        }
    }
    if ([string]::IsNullOrWhiteSpace($candidate)) {
        throw 'Copy a folder in Explorer first, then press this Button.'
    }
    if (-not [System.IO.Path]::IsPathRooted($candidate)) {
        throw "The copied path is not an absolute Windows folder: $candidate"
    }
    $resolved = [System.IO.Path]::GetFullPath($candidate)
    if (-not (Test-Path -LiteralPath $resolved -PathType Container)) {
        throw "The copied path is not an existing folder: $resolved"
    }
    Assert-NotReparsePoint -Path $resolved -Label 'The target folder'
    $trimmed = $resolved.TrimEnd([char[]]@('\', '/'))
    $volumeRoot = ([System.IO.Path]::GetPathRoot($resolved)).TrimEnd([char[]]@('\', '/'))
    if ($trimmed.Equals($volumeRoot, [System.StringComparison]::OrdinalIgnoreCase)) {
        throw 'A drive or share root cannot be organized.'
    }
    return $trimmed
}

function Read-SavedProfile {
    $path = Join-Path (Get-ProgramDataRoot) "profiles\$($script:ProfileId).json"
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "This Button's saved profile no longer exists. Recreate it in Setup Organization."
    }
    $document = Get-Content -LiteralPath $path -Raw -Encoding UTF8 | ConvertFrom-Json -ErrorAction Stop
    if ([string]$document.format -ne $script:ProfileFormat) {
        throw "This Button's saved profile is not a $($script:ProfileFormat) file."
    }
    return $document
}

function Get-OptionalProfileBoolean {
    param(
        [Parameter(Mandatory = $true)]$Profile,
        [Parameter(Mandatory = $true)][string]$Name
    )

    $property = $Profile.PSObject.Properties[$Name]
    if ($null -eq $property) { return $false }
    if ($property.Value -isnot [bool]) {
        throw "This Button's saved profile has an invalid $Name setting. Open and save it again in Setup Organization."
    }
    return [bool]$property.Value
}

function Read-FileGroupsById {
    param([switch]$RequireValid)

    $path = Join-Path (Get-ProgramDataRoot) 'file-groups.json'
    $map = @{}
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        if ($RequireValid) { throw 'The shared file-group definitions are missing, so cleanup cannot determine current profile ownership safely.' }
        return $map
    }
    try {
        $document = Get-Content -LiteralPath $path -Raw -Encoding UTF8 | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        if ($RequireValid) { throw "The shared file-group definitions are invalid, so cleanup cannot determine current profile ownership safely: $($_.Exception.Message)" }
        return $map
    }
    if ($null -eq $document -or $null -eq $document.PSObject.Properties['groups']) {
        if ($RequireValid) { throw 'The shared file-group definitions are incomplete, so cleanup cannot determine current profile ownership safely.' }
        return $map
    }
    foreach ($group in @($document.groups)) {
        if ($null -eq $group) { continue }
        $groupId = ([string]$group.groupId).Trim().ToLowerInvariant()
        if ([string]::IsNullOrWhiteSpace($groupId)) { continue }
        $map[$groupId] = [pscustomobject]@{
            Label = ([string]$group.label).Trim()
            Extensions = @(@($group.fileTypes) | ForEach-Object { ([string]$_).Trim().ToLowerInvariant() } |
                Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
            IsProgram = ($null -ne $group.PSObject.Properties['isProgram'] -and [bool]$group.isProgram)
        }
    }
    return $map
}

function Read-ProfileById {
    param(
        [Parameter(Mandatory = $true)][string]$ProfileId,
        [switch]$RequireValid
    )

    $path = Join-Path (Get-ProgramDataRoot) "profiles\$ProfileId.json"
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        if ($RequireValid) { throw "The configured nested profile '$ProfileId' is missing, so cleanup cannot determine current profile ownership safely." }
        return $null
    }
    try {
        $document = Get-Content -LiteralPath $path -Raw -Encoding UTF8 | ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        if ($RequireValid) { throw "The configured nested profile '$ProfileId' is invalid, so cleanup cannot determine current profile ownership safely: $($_.Exception.Message)" }
        return $null
    }
    if ([string]$document.format -ne $script:ProfileFormat -or
        [string]$document.profileId -ne $ProfileId) {
        if ($RequireValid) { throw "The configured nested profile '$ProfileId' does not match the current profile contract, so cleanup cannot determine ownership safely." }
        return $null
    }
    return $document
}

function Get-EffectiveExtensions {
    param([Parameter(Mandatory = $true)]$Folder, [Parameter(Mandatory = $true)]$GroupsById)

    $result = [System.Collections.Generic.List[string]]::new()
    $seen = @{}
    foreach ($groupId in @($Folder.groupIds)) {
        $key = ([string]$groupId).ToLowerInvariant()
        if (-not $GroupsById.ContainsKey($key)) { continue }
        foreach ($extension in @($GroupsById[$key].Extensions)) {
            if ($seen.ContainsKey($extension)) { continue }
            $seen[$extension] = $true; $result.Add($extension)
        }
    }
    foreach ($extension in @($Folder.fileTypes)) {
        $value = ([string]$extension).Trim().ToLowerInvariant()
        if ([string]::IsNullOrWhiteSpace($value) -or $seen.ContainsKey($value)) { continue }
        $seen[$value] = $true; $result.Add($value)
    }
    return @($result.ToArray())
}

function Normalize-ProgramFolderName {
    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$Name)

    $candidate = $Name.Trim().Trim('.')
    if ([string]::IsNullOrWhiteSpace($candidate)) { return '' }
    $invalid = [System.IO.Path]::GetInvalidFileNameChars()
    if ($candidate.IndexOfAny($invalid) -ge 0) { return '' }
    if ($candidate -eq '.' -or $candidate -eq '..') { return '' }
    if ($candidate.Length -gt 120) { return '' }
    return $candidate
}

function ConvertTo-NativeRelativePath {
    param([Parameter(Mandatory = $true)][string]$RelativePath)

    return $RelativePath.Replace('/', [string][System.IO.Path]::DirectorySeparatorChar)
}

function Test-PathWithinRoot {
    param([Parameter(Mandatory = $true)][string]$Root, [Parameter(Mandatory = $true)][string]$Path)

    $prefix = $Root.TrimEnd([char[]]@('\', '/')) + [System.IO.Path]::DirectorySeparatorChar
    return $Path.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase)
}

function Test-PathEqualsOrWithinRoot {
    param([Parameter(Mandatory = $true)][string]$Root, [Parameter(Mandatory = $true)][string]$Path)

    $trimmedRoot = $Root.TrimEnd([char[]]@('\', '/'))
    $trimmedPath = $Path.TrimEnd([char[]]@('\', '/'))
    return $trimmedPath.Equals($trimmedRoot, [System.StringComparison]::OrdinalIgnoreCase) -or
        (Test-PathWithinRoot -Root $trimmedRoot -Path $trimmedPath)
}

function Test-IsJsonObject {
    param([AllowNull()]$Value)

    return $null -ne $Value -and $Value -is [System.Management.Automation.PSCustomObject]
}

function ConvertTo-ValidatedMarkerRelativePath {
    param(
        [AllowNull()]$Value,
        [Parameter(Mandatory = $true)][string]$TargetRoot,
        [Parameter(Mandatory = $true)][string]$Label,
        [switch]$AllowEmpty,
        [switch]$AllowTargetRoot
    )

    if ($Value -isnot [string]) { throw "$Label must be a text folder path." }
    $raw = [string]$Value
    if ($AllowEmpty -and $raw.Length -eq 0) {
        return [pscustomobject]@{ Relative = ''; Absolute = '' }
    }
    if ([string]::IsNullOrWhiteSpace($raw) -or $raw.Length -gt 520 -or
        [System.IO.Path]::IsPathRooted($raw) -or $raw -match '^[A-Za-z]:' -or
        $raw.StartsWith('\\')) {
        throw "$Label is unsafe: $raw"
    }
    $relative = $raw.Replace('\', '/').Trim('/')
    $segments = @($relative.Split('/'))
    if ($segments.Count -eq 0 -or $segments -contains '' -or $segments -contains '.' -or
        $segments -contains '..') {
        if (-not ($AllowTargetRoot -and $relative -eq '.')) {
            throw "$Label is unsafe: $raw"
        }
    }
    foreach ($segment in $segments) {
        if ($segment -eq '.' -and $AllowTargetRoot) { continue }
        if ($segment.IndexOfAny([System.IO.Path]::GetInvalidFileNameChars()) -ge 0) {
            throw "$Label is unsafe: $raw"
        }
    }
    try {
        $absolute = [System.IO.Path]::GetFullPath(
            (Join-Path $TargetRoot (ConvertTo-NativeRelativePath -RelativePath $relative))).TrimEnd([char[]]@('\', '/'))
    }
    catch {
        throw "$Label is invalid: $raw"
    }
    $targetNormalized = $TargetRoot.TrimEnd([char[]]@('\', '/'))
    $equalsTarget = $absolute.Equals($targetNormalized, [System.StringComparison]::OrdinalIgnoreCase)
    if (($equalsTarget -and -not $AllowTargetRoot) -or
        (-not $equalsTarget -and -not (Test-PathWithinRoot -Root $targetNormalized -Path $absolute))) {
        throw "$Label resolves outside the project: $raw"
    }
    return [pscustomobject]@{ Relative = $relative; Absolute = $absolute }
}

function Read-PreviousIgnoredRoots {
    param([Parameter(Mandatory = $true)][string]$TargetRoot)

    $markerPath = Join-Path $TargetRoot $script:MarkerFileName
    try {
        if (-not (Test-Path -LiteralPath $markerPath -ErrorAction Stop)) { return @() }
        $markerItem = Get-Item -LiteralPath $markerPath -Force -ErrorAction Stop
    }
    catch {
        throw "Could not safely inspect the existing project marker: $($_.Exception.Message)"
    }
    if ($markerItem.PSIsContainer) {
        throw "The project marker path is a folder, not a file: $markerPath"
    }
    if (($markerItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "The project marker cannot be a symbolic link or reparse point: $markerPath"
    }

    try {
        $document = Get-Content -LiteralPath $markerPath -Raw -Encoding UTF8 -ErrorAction Stop |
            ConvertFrom-Json -ErrorAction Stop
    }
    catch {
        throw "The existing project marker is invalid and was left untouched: $($_.Exception.Message)"
    }
    if (-not (Test-IsJsonObject -Value $document)) {
        throw 'The existing project marker must be one JSON object.'
    }
    $requiredProperties = @(
        'schemaVersion', 'format', 'profileId', 'profileName', 'organizedAt',
        'where', 'catchAll', 'programFolders', 'ignored')
    $actualProperties = @($document.PSObject.Properties | ForEach-Object { $_.Name })
    if ($actualProperties.Count -ne $requiredProperties.Count) {
        throw 'The existing project marker does not match the FlowCell project-marker v1 contract.'
    }
    foreach ($propertyName in $requiredProperties) {
        if ($actualProperties -cnotcontains $propertyName) {
            throw 'The existing project marker does not match the FlowCell project-marker v1 contract.'
        }
    }

    $formatProperty = $document.PSObject.Properties['format']
    $schemaProperty = $document.PSObject.Properties['schemaVersion']
    $profileProperty = $document.PSObject.Properties['profileId']
    $profileNameProperty = $document.PSObject.Properties['profileName']
    $organizedAtProperty = $document.PSObject.Properties['organizedAt']
    $whereProperty = $document.PSObject.Properties['where']
    $catchAllProperty = $document.PSObject.Properties['catchAll']
    $programFoldersProperty = $document.PSObject.Properties['programFolders']
    $ignoredProperty = $document.PSObject.Properties['ignored']
    if ($formatProperty.Value -isnot [string] -or [string]$formatProperty.Value -ne $script:MarkerFormat -or
        (($schemaProperty.Value -isnot [int]) -and ($schemaProperty.Value -isnot [long])) -or
        [long]$schemaProperty.Value -ne 1 -or
        $profileProperty.Value -isnot [string] -or
        [string]$profileProperty.Value -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' -or
        $profileNameProperty.Value -isnot [string] -or
        [string]::IsNullOrEmpty([string]$profileNameProperty.Value) -or
        ([string]$profileNameProperty.Value).Length -gt 120 -or
        $organizedAtProperty.Value -isnot [string] -or
        [string]$organizedAtProperty.Value -notmatch '(?:Z|[+-][0-9]{2}:[0-9]{2})$' -or
        -not (Test-IsJsonObject -Value $whereProperty.Value) -or
        $catchAllProperty.Value -isnot [string] -or
        -not (Test-IsJsonObject -Value $programFoldersProperty.Value) -or
        $ignoredProperty.Value -isnot [System.Array]) {
        throw 'The existing project marker does not match the FlowCell project-marker v1 contract.'
    }

    $parsedOrganizedAt = [DateTimeOffset]::MinValue
    if (-not [DateTimeOffset]::TryParse(
        [string]$organizedAtProperty.Value,
        [System.Globalization.CultureInfo]::InvariantCulture,
        [System.Globalization.DateTimeStyles]::RoundtripKind,
        [ref]$parsedOrganizedAt)) {
        throw 'The existing project marker has an invalid organizedAt timestamp.'
    }
    foreach ($property in @($whereProperty.Value.PSObject.Properties)) {
        $extension = [string]$property.Name
        if ($extension.Length -gt 32 -or $extension -notmatch '^\.[a-z0-9][a-z0-9._+\-]*$') {
            throw "The existing project marker contains an invalid destination extension: $extension"
        }
        [void](ConvertTo-ValidatedMarkerRelativePath -Value $property.Value -TargetRoot $TargetRoot `
            -Label "The existing project marker destination for '$extension'" -AllowTargetRoot)
    }
    if ([string]$catchAllProperty.Value -ne '') {
        [void](ConvertTo-ValidatedMarkerRelativePath -Value $catchAllProperty.Value -TargetRoot $TargetRoot `
            -Label 'The existing project marker catch-all folder' -AllowTargetRoot)
    }
    foreach ($property in @($programFoldersProperty.Value.PSObject.Properties)) {
        [void](ConvertTo-ValidatedMarkerRelativePath -Value $property.Value -TargetRoot $TargetRoot `
            -Label "The existing project marker program folder '$($property.Name)'" -AllowTargetRoot)
    }

    $roots = [System.Collections.Generic.List[string]]::new()
    $seen = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::OrdinalIgnoreCase)
    foreach ($entry in $ignoredProperty.Value) {
        $validated = ConvertTo-ValidatedMarkerRelativePath -Value $entry -TargetRoot $TargetRoot `
            -Label 'The existing project marker ignored folder'
        if ($seen.Add($validated.Absolute)) { $roots.Add($validated.Absolute) }
    }
    return @($roots.ToArray())
}

function Write-ProjectMarker {
    param(
        [Parameter(Mandatory = $true)][string]$TargetRoot,
        [Parameter(Mandatory = $true)]$Marker
    )

    $markerPath = Join-Path $TargetRoot $script:MarkerFileName
    if (Test-Path -LiteralPath $markerPath) {
        $markerItem = Get-Item -LiteralPath $markerPath -Force -ErrorAction Stop
        if ($markerItem.PSIsContainer -or
            ($markerItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
            throw "The project marker cannot be replaced safely: $markerPath"
        }
    }
    $temporaryPath = Join-Path $TargetRoot ".flowcell-project.$([guid]::NewGuid().ToString('N')).tmp"
    try {
        $markerJson = $Marker | ConvertTo-Json -Depth 12
        [System.IO.File]::WriteAllText(
            $temporaryPath, $markerJson, [System.Text.UTF8Encoding]::new($false))
        Move-Item -LiteralPath $temporaryPath -Destination $markerPath -Force -ErrorAction Stop
    }
    finally {
        if (Test-Path -LiteralPath $temporaryPath -PathType Leaf) {
            Remove-Item -LiteralPath $temporaryPath -Force -ErrorAction SilentlyContinue
        }
    }
}

function Send-PathToRecycleBin {
    param([Parameter(Mandatory = $true)][string]$Path)

    Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop
    if (Test-Path -LiteralPath $Path -PathType Container) {
        [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory(
            $Path,
            [Microsoft.VisualBasic.FileIO.UIOption]::OnlyErrorDialogs,
            [Microsoft.VisualBasic.FileIO.RecycleOption]::SendToRecycleBin)
        return
    }
    [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile(
        $Path,
        [Microsoft.VisualBasic.FileIO.UIOption]::OnlyErrorDialogs,
        [Microsoft.VisualBasic.FileIO.RecycleOption]::SendToRecycleBin)
}

function Get-SafeDirectorySnapshot {
    param([Parameter(Mandatory = $true)][string]$Root)

    $directories = [System.Collections.Generic.List[string]]::new()
    $queue = [System.Collections.Generic.Queue[string]]::new()
    $queue.Enqueue($Root)
    while ($queue.Count -gt 0) {
        $current = $queue.Dequeue()
        $children = @(Get-ChildItem -LiteralPath $current -Directory -Force -ErrorAction Stop)
        foreach ($child in $children) {
            if (($child.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
            $fullName = [System.IO.Path]::GetFullPath($child.FullName).TrimEnd([char[]]@('\', '/'))
            if (-not (Test-PathWithinRoot -Root $Root -Path $fullName)) {
                throw "Folder cleanup found a path outside the target: $fullName"
            }
            $directories.Add($fullName)
            $queue.Enqueue($fullName)
        }
    }
    return @($directories.ToArray())
}

function Assert-TreeSafeForRecycle {
    param(
        [Parameter(Mandatory = $true)][string]$TargetRoot,
        [Parameter(Mandatory = $true)][string]$TreeRoot
    )

    if (-not (Test-PathWithinRoot -Root $TargetRoot -Path $TreeRoot)) {
        throw "Refusing to recycle a folder outside the target: $TreeRoot"
    }
    $targetNormalized = [System.IO.Path]::GetFullPath($TargetRoot).TrimEnd([char[]]@('\', '/'))
    $ancestor = [System.IO.Path]::GetFullPath($TreeRoot).TrimEnd([char[]]@('\', '/'))
    while (-not $ancestor.Equals($targetNormalized, [System.StringComparison]::OrdinalIgnoreCase)) {
        Assert-NotReparsePoint -Path $ancestor -Label 'A cleanup folder or its ancestor'
        $parent = [System.IO.Directory]::GetParent($ancestor)
        if ($null -eq $parent) { throw "Could not validate cleanup ancestry for: $TreeRoot" }
        $ancestor = $parent.FullName.TrimEnd([char[]]@('\', '/'))
    }
    $queue = [System.Collections.Generic.Queue[string]]::new()
    $queue.Enqueue($TreeRoot)
    while ($queue.Count -gt 0) {
        $current = $queue.Dequeue()
        foreach ($child in @(Get-ChildItem -LiteralPath $current -Force -ErrorAction Stop)) {
            if (($child.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
                throw "Folder cleanup will not cross a symbolic link or reparse point: $($child.FullName)"
            }
            if ($child.PSIsContainer) { $queue.Enqueue($child.FullName) }
        }
    }
}

function Get-OutermostDirectoryRoots {
    param([Parameter(Mandatory = $true)][AllowNull()]$Paths)

    $roots = [System.Collections.Generic.List[string]]::new()
    foreach ($path in @($Paths | Sort-Object { ([string]$_).Length })) {
        $candidate = ([string]$path).TrimEnd([char[]]@('\', '/'))
        if ([string]::IsNullOrWhiteSpace($candidate)) { continue }
        $nested = $false
        foreach ($root in $roots) {
            if (Test-PathEqualsOrWithinRoot -Root $root -Path $candidate) {
                $nested = $true
                break
            }
        }
        if (-not $nested) { $roots.Add($candidate) }
    }
    return @($roots.ToArray())
}

function Add-ProtectedDirectoryAndAncestors {
    param(
        [Parameter(Mandatory = $true)][string]$TargetRoot,
        [Parameter(Mandatory = $true)][string]$Directory,
        [Parameter(Mandatory = $true)]$ProtectedDirectories
    )

    $root = [System.IO.Path]::GetFullPath($TargetRoot).TrimEnd([char[]]@('\', '/'))
    $current = [System.IO.Path]::GetFullPath($Directory).TrimEnd([char[]]@('\', '/'))
    if (-not $current.Equals($root, [System.StringComparison]::OrdinalIgnoreCase) -and
        -not (Test-PathWithinRoot -Root $root -Path $current)) {
        throw "A profile folder resolves outside the target folder: $current"
    }

    while ($true) {
        [void]$ProtectedDirectories.Add($current)
        if ($current.Equals($root, [System.StringComparison]::OrdinalIgnoreCase)) { break }
        $parent = [System.IO.Directory]::GetParent($current)
        if ($null -eq $parent) {
            throw "Could not resolve a profile folder's parent inside the target: $current"
        }
        $current = $parent.FullName.TrimEnd([char[]]@('\', '/'))
    }
}

try {
    $target = Resolve-TargetFolder -Argument $TargetPath
    $plannedExtensionValue = $PlannedExtension.Trim().ToLowerInvariant()
    if (-not [string]::IsNullOrWhiteSpace($plannedExtensionValue) -and
        ($plannedExtensionValue.Length -gt 32 -or
            $plannedExtensionValue -notmatch '^\.[a-z0-9][a-z0-9._+\-]*$')) {
        throw "The planned file extension is invalid: $PlannedExtension"
    }
    $previousIgnoredRoots = @(Read-PreviousIgnoredRoots -TargetRoot $target)
    $profile = Read-SavedProfile
    $recycleOtherFolders = Get-OptionalProfileBoolean -Profile $profile -Name 'recycleOtherFolders'
    $recyclePreviousIgnoredFolders = Get-OptionalProfileBoolean -Profile $profile -Name 'recyclePreviousIgnoredFolders'
    if ($recyclePreviousIgnoredFolders -and -not $recycleOtherFolders) {
        throw 'This profile cannot recycle ignored folders left by the previous profile unless empty non-profile-folder cleanup is enabled.'
    }
    $requiresProgramOwnership = $false
    if ($recycleOtherFolders -and $null -ne $profile.PSObject.Properties['programFolders']) {
        foreach ($programFolder in @($profile.programFolders)) {
            if ($null -ne $programFolder.PSObject.Properties['createInRoot'] -and
                [bool]$programFolder.createInRoot) {
                $requiresProgramOwnership = $true
                break
            }
        }
    }
    $groupsById = Read-FileGroupsById -RequireValid:$requiresProgramOwnership

    # Snapshot the original tree before this profile creates any folders. Marker
    # paths are eligible for cleanup only when this traversal reached them
    # without crossing a reparse point.
    $skipped = [System.Collections.Generic.List[string]]::new()
    $cleanupDirectories = @()
    $cleanupDirectorySet = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::OrdinalIgnoreCase)
    if ($recycleOtherFolders) {
        try {
            $cleanupDirectories = @(Get-SafeDirectorySnapshot -Root $target)
            foreach ($directory in $cleanupDirectories) { [void]$cleanupDirectorySet.Add($directory) }
        }
        catch {
            throw "Could not safely inspect the target before folder cleanup: $($_.Exception.Message)"
        }
    }

    # Destructive stale-folder cleanup is fail closed. Resolve every current
    # static/program/nested path before creating or moving anything so missing
    # shared definitions can never make a current folder look stale.
    $nestedProfilesById = @{}
    if ($recycleOtherFolders) {
        foreach ($folder in @($profile.folders)) {
            $relative = ([string]$folder.path).Trim().Replace('\', '/').Trim('/')
            if ($relative -eq '.' -or [string]::IsNullOrWhiteSpace($relative)) { continue }
            try {
                $absolute = [System.IO.Path]::GetFullPath(
                    (Join-Path $target (ConvertTo-NativeRelativePath -RelativePath $relative)))
            }
            catch {
                throw "The current profile contains an invalid folder path '$relative', so cleanup cannot determine ownership safely."
            }
            if (-not (Test-PathWithinRoot -Root $target -Path $absolute)) {
                throw "The current profile folder '$relative' resolves outside the target, so cleanup cannot determine ownership safely."
            }
        }

        if ($null -ne $profile.PSObject.Properties['programFolders']) {
            foreach ($programFolder in @($profile.programFolders)) {
                $createInRoot = $false
                if ($null -ne $programFolder.PSObject.Properties['createInRoot']) {
                    $createInRoot = [bool]$programFolder.createInRoot
                }
                if (-not $createInRoot) { continue }

                $groupKey = ([string]$programFolder.groupId).Trim().ToLowerInvariant()
                if ([string]::IsNullOrWhiteSpace($groupKey) -or -not $groupsById.ContainsKey($groupKey)) {
                    throw "The current profile references the missing program file group '$groupKey', so cleanup cannot determine ownership safely."
                }
                $group = $groupsById[$groupKey]
                if (-not $group.IsProgram -or @($group.Extensions).Count -eq 0) {
                    throw "The current profile's '$groupKey' program file group is incomplete, so cleanup cannot determine ownership safely."
                }
                $programRelative = Normalize-ProgramFolderName -Name $group.Label
                if ([string]::IsNullOrWhiteSpace($programRelative)) {
                    throw "The current profile's '$groupKey' program folder name is invalid, so cleanup cannot determine ownership safely."
                }
                $programPath = [System.IO.Path]::GetFullPath((Join-Path $target $programRelative))
                if (-not (Test-PathWithinRoot -Root $target -Path $programPath)) {
                    throw "The current profile's '$groupKey' program folder resolves outside the target."
                }

                $nestedProfileId = ''
                if ($null -ne $programFolder.PSObject.Properties['profileId']) {
                    $nestedProfileId = ([string]$programFolder.profileId).Trim().ToLowerInvariant()
                }
                if ([string]::IsNullOrWhiteSpace($nestedProfileId)) { continue }
                $nested = Read-ProfileById -ProfileId $nestedProfileId -RequireValid
                foreach ($nestedFolder in @($nested.folders)) {
                    $nestedRelative = ([string]$nestedFolder.path).Trim().Replace('\', '/').Trim('/')
                    if ([string]::IsNullOrWhiteSpace($nestedRelative)) {
                        throw "The configured nested profile '$nestedProfileId' contains an empty folder path, so cleanup cannot determine ownership safely."
                    }
                    try {
                        $nestedAbsolute = [System.IO.Path]::GetFullPath(
                            (Join-Path $programPath (ConvertTo-NativeRelativePath -RelativePath $nestedRelative)))
                    }
                    catch {
                        throw "The configured nested profile '$nestedProfileId' contains an invalid folder path '$nestedRelative'."
                    }
                    if (-not (Test-PathEqualsOrWithinRoot -Root $programPath -Path $nestedAbsolute)) {
                        throw "The configured nested profile '$nestedProfileId' contains a folder outside its program folder."
                    }
                }
                $nestedProfilesById[$nestedProfileId] = $nested
            }
        }
    }

    $folders = @($profile.folders)
    $routes = [System.Collections.Generic.List[object]]::new()
    $ignoredRelative = [System.Collections.Generic.List[string]]::new()
    $ignoredRoots = [System.Collections.Generic.List[string]]::new()
    $destinationMap = [ordered]@{}
    $foldersCreated = 0
    $profileFoldersToCreate = [System.Collections.Generic.List[string]]::new()
    $catchAllRoute = $null
    $catchAllRelative = ''
    $protectedDirectories = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::OrdinalIgnoreCase)

    foreach ($folder in $folders) {
        $relative = ([string]$folder.path).Trim().Replace('\', '/').Trim('/')
        $isRoot = ($relative -eq '.' -or [string]::IsNullOrWhiteSpace($relative))
        if ($isRoot) {
            $relative = '.'
            $absolute = $target
        }
        else {
            $absolute = [System.IO.Path]::GetFullPath((Join-Path $target (ConvertTo-NativeRelativePath -RelativePath $relative)))
            if (-not (Test-PathWithinRoot -Root $target -Path $absolute)) {
                throw "The profile folder '$relative' resolves outside the target folder."
            }
        }
        Add-ProtectedDirectoryAndAncestors -TargetRoot $target -Directory $absolute `
            -ProtectedDirectories $protectedDirectories

        if (-not $isRoot -and -not (Test-Path -LiteralPath $absolute -PathType Container)) {
            $profileFoldersToCreate.Add($absolute)
        }

        if ($folder.ignored) {
            $ignoredRelative.Add($relative)
            $ignoredRoots.Add($absolute)
            continue
        }

        $isCatchAll = $false
        if ($null -ne $folder.PSObject.Properties['catchAll']) { $isCatchAll = [bool]$folder.catchAll }
        if ($isCatchAll -and $null -eq $catchAllRoute) {
            $catchAllRoute = [pscustomobject]@{ Relative = $relative; Path = $absolute }
            $catchAllRelative = $relative
        }

        $extensions = @(Get-EffectiveExtensions -Folder $folder -GroupsById $groupsById)
        if ($extensions.Count -eq 0) { continue }
        $routes.Add([pscustomobject]@{ Relative = $relative; Path = $absolute; Extensions = $extensions })
        foreach ($extension in $extensions) {
            if (-not $destinationMap.Contains($extension)) { $destinationMap[$extension] = $relative }
        }
    }

    # Build the logical program-owned tree before scanning for matching files.
    # Existing folders remain owned by the current profile even on a run where
    # no matching program file activates their route.
    $programRoutes = [System.Collections.Generic.List[object]]::new()
    $programFolderMap = [ordered]@{}
    $programFolderList = @()
    if ($null -ne $profile.PSObject.Properties['programFolders']) {
        $programFolderList = @($profile.programFolders)
    }
    $programDefinitions = [System.Collections.Generic.List[object]]::new()
    foreach ($programFolder in $programFolderList) {
        $groupKey = ([string]$programFolder.groupId).ToLowerInvariant()
        if (-not $groupsById.ContainsKey($groupKey)) { continue }
        $group = $groupsById[$groupKey]
        $extensions = @($group.Extensions)
        if ($extensions.Count -eq 0) { continue }

        $createInRoot = $false
        if ($null -ne $programFolder.PSObject.Properties['createInRoot']) {
            $createInRoot = [bool]$programFolder.createInRoot
        }
        if (-not $createInRoot) { continue }

        $programRelative = Normalize-ProgramFolderName -Name $group.Label
        if ([string]::IsNullOrWhiteSpace($programRelative)) { continue }
        $programPath = [System.IO.Path]::GetFullPath((Join-Path $target $programRelative))
        if (-not (Test-PathWithinRoot -Root $target -Path $programPath)) { continue }
        Add-ProtectedDirectoryAndAncestors -TargetRoot $target -Directory $programPath `
            -ProtectedDirectories $protectedDirectories

        $nestedDefinitions = [System.Collections.Generic.List[object]]::new()
        $nestedProfileId = ''
        if ($null -ne $programFolder.PSObject.Properties['profileId']) {
            $nestedProfileId = ([string]$programFolder.profileId).Trim().ToLowerInvariant()
        }
        if (-not [string]::IsNullOrWhiteSpace($nestedProfileId)) {
            $nested = if ($nestedProfilesById.ContainsKey($nestedProfileId)) {
                $nestedProfilesById[$nestedProfileId]
            } else {
                Read-ProfileById -ProfileId $nestedProfileId
            }
            if ($null -ne $nested) {
                foreach ($nestedFolder in @($nested.folders)) {
                    $nestedRelative = ([string]$nestedFolder.path).Trim().Replace('\', '/').Trim('/')
                    if ([string]::IsNullOrWhiteSpace($nestedRelative)) { continue }
                    $nestedAbsolute = [System.IO.Path]::GetFullPath(
                        (Join-Path $programPath (ConvertTo-NativeRelativePath -RelativePath $nestedRelative)))
                    if (-not (Test-PathEqualsOrWithinRoot -Root $programPath -Path $nestedAbsolute)) { continue }
                    Add-ProtectedDirectoryAndAncestors -TargetRoot $target -Directory $nestedAbsolute `
                        -ProtectedDirectories $protectedDirectories

                    $nestedIsIgnored = $false
                    if ($null -ne $nestedFolder.PSObject.Properties['ignored']) {
                        $nestedIsIgnored = [bool]$nestedFolder.ignored
                    }
                    $nestedGroupIds = @()
                    if ($null -ne $nestedFolder.PSObject.Properties['groupIds']) {
                        $nestedGroupIds = @($nestedFolder.groupIds | ForEach-Object { ([string]$_).ToLowerInvariant() })
                    }
                    if ($nestedIsIgnored) {
                        $ignoredRelative.Add("$programRelative/$nestedRelative")
                        $ignoredRoots.Add($nestedAbsolute)
                    }
                    $nestedDefinitions.Add([pscustomobject]@{
                        Relative = $nestedRelative
                        FullRelative = "$programRelative/$nestedRelative"
                        Path = $nestedAbsolute
                        Ignored = $nestedIsIgnored
                        GroupIds = $nestedGroupIds
                    })
                }
            }
        }

        $programDefinitions.Add([pscustomobject]@{
            Group = $group
            GroupKey = $groupKey
            Extensions = $extensions
            Relative = $programRelative
            Path = $programPath
            NestedFolders = @($nestedDefinitions.ToArray())
        })
    }

    # A previous marker is the lineage for folders that an older profile left
    # untouched. Only roots reached by the safe pre-mutation snapshot and no
    # longer owned by the current profile can become cleanup candidates.
    $previousIgnoredRootsToRecycle = @()
    if ($recyclePreviousIgnoredFolders) {
        $previousIgnoredCandidates = [System.Collections.Generic.List[string]]::new()
        foreach ($previousIgnoredRoot in $previousIgnoredRoots) {
            if ($protectedDirectories.Contains($previousIgnoredRoot)) { continue }
            $insideCurrentIgnoredTree = $false
            foreach ($ignoredRoot in $ignoredRoots) {
                if (Test-PathEqualsOrWithinRoot -Root $ignoredRoot -Path $previousIgnoredRoot) {
                    $insideCurrentIgnoredTree = $true
                    break
                }
            }
            if ($insideCurrentIgnoredTree) { continue }

            $previousPathExists = $false
            try {
                $previousPathExists = Test-Path -LiteralPath $previousIgnoredRoot -ErrorAction Stop
            }
            catch {
                throw "Could not safely inspect a stale ignored folder from the previous marker: $previousIgnoredRoot"
            }
            if (-not $previousPathExists) { continue }
            if (-not (Test-Path -LiteralPath $previousIgnoredRoot -PathType Container) -or
                -not $cleanupDirectorySet.Contains($previousIgnoredRoot)) {
                throw "A stale ignored path from the previous marker is not a safe in-project folder. The previous marker was kept: $previousIgnoredRoot"
            }
            $previousIgnoredCandidates.Add($previousIgnoredRoot)
        }
        $previousIgnoredRootsToRecycle = @(
            Get-OutermostDirectoryRoots -Paths $previousIgnoredCandidates.ToArray())
    }

    foreach ($profileFolderPath in $profileFoldersToCreate) {
        if (Test-Path -LiteralPath $profileFolderPath -PathType Container) { continue }
        New-Item -ItemType Directory -Path $profileFolderPath -Force | Out-Null
        $foldersCreated += 1
    }

    # Program folders are created only when a matching file exists outside both
    # the current profile's ignored trees and stale previous-profile trees.
    if ($programDefinitions.Count -gt 0) {
        $preScan = @()
        try {
            $preScan = @(Get-ChildItem -LiteralPath $target -File -Recurse -Force -ErrorAction SilentlyContinue)
        }
        catch {
            $preScan = @()
        }
        $presentExtensions = @{}
        if (-not [string]::IsNullOrWhiteSpace($plannedExtensionValue)) {
            $presentExtensions[$plannedExtensionValue] = $true
        }
        foreach ($file in $preScan) {
            if (($file.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
            $inIgnored = $false
            foreach ($ignoredRoot in $ignoredRoots) {
                if (Test-PathWithinRoot -Root $ignoredRoot -Path $file.FullName) { $inIgnored = $true; break }
            }
            if ($inIgnored) { continue }
            $inPreviousIgnoredTree = $false
            foreach ($previousIgnoredRoot in $previousIgnoredRootsToRecycle) {
                if (Test-PathWithinRoot -Root $previousIgnoredRoot -Path $file.FullName) {
                    $inPreviousIgnoredTree = $true
                    break
                }
            }
            if ($inPreviousIgnoredTree) { continue }
            if ($file.Name -eq $script:MarkerFileName -or $script:LegacyArtifactNames -contains $file.Name) { continue }
            $presentExtensions[$file.Extension.ToLowerInvariant()] = $true
        }

        foreach ($definition in $programDefinitions) {
            $anyPresent = $false
            foreach ($extension in $definition.Extensions) {
                if ($presentExtensions.ContainsKey($extension)) { $anyPresent = $true; break }
            }
            if (-not $anyPresent) { continue }

            if (-not (Test-Path -LiteralPath $definition.Path -PathType Container)) {
                New-Item -ItemType Directory -Path $definition.Path -Force | Out-Null
                $foldersCreated += 1
            }
            $programFolderMap[$definition.Group.Label] = $definition.Relative

            # Destination inside the program folder, defaulting to its root.
            $destinationPath = $definition.Path
            $destinationRelative = $definition.Relative
            foreach ($nestedFolder in $definition.NestedFolders) {
                if (-not (Test-Path -LiteralPath $nestedFolder.Path -PathType Container)) {
                    New-Item -ItemType Directory -Path $nestedFolder.Path -Force | Out-Null
                    $foldersCreated += 1
                }
                if (-not $nestedFolder.Ignored -and $nestedFolder.GroupIds -contains $definition.GroupKey) {
                    $destinationPath = $nestedFolder.Path
                    $destinationRelative = $nestedFolder.FullRelative
                }
            }

            $programRoutes.Add([pscustomobject]@{
                Relative = $destinationRelative
                Path = $destinationPath
                Extensions = $definition.Extensions
            })
            foreach ($extension in $definition.Extensions) {
                $destinationMap[$extension] = $destinationRelative
            }
        }
    }

    # Recursive: every file under the target at any depth, except inside an
    # ignored subtree. Files that match nothing are left exactly where they are.
    $moved = 0
    $journalMoves = [System.Collections.Generic.List[object]]::new()
    $legacyArtifacts = [System.Collections.Generic.List[string]]::new()

    $candidates = @()
    try {
        $candidates = @(Get-ChildItem -LiteralPath $target -File -Recurse -Force -ErrorAction SilentlyContinue)
    }
    catch {
        $candidates = @()
    }

    foreach ($file in $candidates) {
        if (($file.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
        if ($file.Name -eq $script:MarkerFileName) { continue }

        $isIgnored = $false
        foreach ($ignoredRoot in $ignoredRoots) {
            if (Test-PathWithinRoot -Root $ignoredRoot -Path $file.FullName) { $isIgnored = $true; break }
        }
        if ($isIgnored) { continue }

        $insidePreviousIgnoredFolderToRecycle = $false
        foreach ($previousIgnoredRoot in $previousIgnoredRootsToRecycle) {
            if (Test-PathWithinRoot -Root $previousIgnoredRoot -Path $file.FullName) {
                $insidePreviousIgnoredFolderToRecycle = $true
                break
            }
        }
        if ($insidePreviousIgnoredFolderToRecycle) { continue }

        if ($script:LegacyArtifactNames -contains $file.Name) {
            $legacyArtifacts.Add($file.FullName)
            continue
        }

        $extension = $file.Extension.ToLowerInvariant()

        $route = $null
        if (-not [string]::IsNullOrWhiteSpace($extension)) {
            foreach ($candidate in $programRoutes) {
                if ($candidate.Extensions -contains $extension) { $route = $candidate; break }
            }
            if ($null -eq $route) {
                foreach ($candidate in $routes) {
                    if ($candidate.Extensions -contains $extension) { $route = $candidate; break }
                }
            }
        }
        # Nothing claimed it: the catch-all folder collects it when the profile
        # declares one, otherwise the file stays exactly where it is.
        if ($null -eq $route) { $route = $catchAllRoute }
        if ($null -eq $route) { continue }

        # Already home.
        if ($file.DirectoryName.TrimEnd([char[]]@('\', '/')).Equals($route.Path.TrimEnd([char[]]@('\', '/')), [System.StringComparison]::OrdinalIgnoreCase)) {
            continue
        }

        $destination = Join-Path $route.Path $file.Name
        if (Test-Path -LiteralPath $destination) {
            $skipped.Add("$($file.Name) (a file with that name is already in $($route.Relative))")
            continue
        }
        try {
            Move-Item -LiteralPath $file.FullName -Destination $destination -ErrorAction Stop
        }
        catch {
            $skipped.Add("$($file.Name) ($($_.Exception.Message))")
            continue
        }
        $moved += 1
        $journalMoves.Add([ordered]@{ from = $file.FullName; to = $destination })
    }

    # Legacy organizer metadata belongs to the retired organizer and must never
    # become project content. It is collected during the scan, then recycled
    # only after all ordinary file moves have finished.
    $legacyArtifactsRecycled = 0
    foreach ($legacyPath in @($legacyArtifacts.ToArray())) {
        if (-not (Test-Path -LiteralPath $legacyPath -PathType Leaf)) { continue }
        try {
            Send-PathToRecycleBin -Path $legacyPath
            $legacyArtifactsRecycled += 1
        }
        catch {
            $skipped.Add("$([System.IO.Path]::GetFileName($legacyPath)) ($($_.Exception.Message))")
        }
    }

    # Stale ignored trees from the previous marker were excluded from both the
    # program pre-scan and ordinary routing, so their contents remain untouched.
    $previousIgnoredFoldersRecycled = 0
    $staleCleanupFailure = $null
    if ($recyclePreviousIgnoredFolders) {
        foreach ($previousIgnoredRoot in $previousIgnoredRootsToRecycle) {
            if (-not (Test-Path -LiteralPath $previousIgnoredRoot -PathType Container)) { continue }
            try {
                Assert-TreeSafeForRecycle -TargetRoot $target -TreeRoot $previousIgnoredRoot
                Send-PathToRecycleBin -Path $previousIgnoredRoot
                $previousIgnoredFoldersRecycled += 1
            }
            catch {
                $staleCleanupFailure = "$previousIgnoredRoot ($($_.Exception.Message))"
                $skipped.Add($staleCleanupFailure)
                break
            }
        }
    }

    $otherFoldersRecycled = 0
    if ($recycleOtherFolders -and $null -eq $staleCleanupFailure) {
        foreach ($directory in @($cleanupDirectories | Sort-Object { ([string]$_).Length } -Descending)) {
            if (-not (Test-Path -LiteralPath $directory -PathType Container)) { continue }
            if ($protectedDirectories.Contains($directory)) { continue }

            # A profile-authored ignored tree is always protected.
            $insideIgnoredTree = $false
            foreach ($ignoredRoot in $ignoredRoots) {
                if (Test-PathEqualsOrWithinRoot -Root $ignoredRoot -Path $directory) {
                    $insideIgnoredTree = $true
                    break
                }
            }
            if ($insideIgnoredTree) { continue }

            # If stale ignored-tree cleanup failed closed, do not partially
            # clean that candidate during the later empty-folder pass.
            $insidePreviousIgnoredCandidate = $false
            foreach ($previousIgnoredRoot in $previousIgnoredRootsToRecycle) {
                if (Test-PathEqualsOrWithinRoot -Root $previousIgnoredRoot -Path $directory) {
                    $insidePreviousIgnoredCandidate = $true
                    break
                }
            }
            if ($insidePreviousIgnoredCandidate) { continue }

            try {
                $item = Get-Item -LiteralPath $directory -Force -ErrorAction Stop
                if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { continue }
                $remaining = @(Get-ChildItem -LiteralPath $directory -Force -ErrorAction Stop | Select-Object -First 1)
                if ($remaining.Count -gt 0) { continue }
                Send-PathToRecycleBin -Path $directory
                $otherFoldersRecycled += 1
            }
            catch {
                $skipped.Add("$directory ($($_.Exception.Message))")
            }
        }
    }

    $organizedAt = [DateTimeOffset]::UtcNow.ToString('o')

    # The marker is what lets program packages (the Blender bridge, and anything
    # else) resolve this project's destinations for whichever profile organized
    # it, instead of assuming one fixed layout.
    $marker = [ordered]@{
        schemaVersion = 1
        format = $script:MarkerFormat
        profileId = [string]$profile.profileId
        profileName = [string]$profile.name
        organizedAt = $organizedAt
        where = $destinationMap
        catchAll = $catchAllRelative
        programFolders = $programFolderMap
        ignored = @($ignoredRelative.ToArray())
    }

    if ($journalMoves.Count -gt 0) {
        $journal = [ordered]@{
            schemaVersion = 1
            format = $script:JournalFormat
            operationId = ([guid]::NewGuid()).ToString('D').ToLowerInvariant()
            profileId = [string]$profile.profileId
            rootPath = $target
            createdAt = $organizedAt
            moves = @($journalMoves.ToArray())
        }
        $journalRoot = Join-Path (Get-ProgramDataRoot) 'undo'
        if (-not (Test-Path -LiteralPath $journalRoot -PathType Container)) {
            New-Item -ItemType Directory -Path $journalRoot -Force | Out-Null
        }
        $journalPath = Join-Path $journalRoot "$($journal.operationId).json"
        [System.IO.File]::WriteAllText($journalPath, ($journal | ConvertTo-Json -Depth 12), [System.Text.UTF8Encoding]::new($false))
    }

    if ($null -ne $staleCleanupFailure) {
        throw "A stale ignored folder could not be recycled. The previous project marker was kept so cleanup can retry: $staleCleanupFailure"
    }
    Write-ProjectMarker -TargetRoot $target -Marker $marker

    $fileLabel = if ($moved -eq 1) { 'file' } else { 'files' }
    $folderLabel = if ($foldersCreated -eq 1) { 'folder' } else { 'folders' }
    $message = "$($profile.name): $foldersCreated $folderLabel created, $moved $fileLabel moved."
    if ($legacyArtifactsRecycled -gt 0) {
        $message += " $legacyArtifactsRecycled legacy organizer file(s) recycled."
    }
    $totalFoldersRecycled = $previousIgnoredFoldersRecycled + $otherFoldersRecycled
    if ($totalFoldersRecycled -gt 0) {
        $message += " $totalFoldersRecycled folder(s) recycled."
    }
    if ($skipped.Count -gt 0) {
        $message += " $($skipped.Count) skipped."
    }
    [Console]::Out.WriteLine(([ordered]@{
        message = $message
        rootPath = $target
        profileId = [string]$profile.profileId
        foldersCreated = $foldersCreated
        filesMoved = $moved
        legacyArtifactsRecycled = $legacyArtifactsRecycled
        otherFoldersRecycled = $otherFoldersRecycled
        previousIgnoredFoldersRecycled = $previousIgnoredFoldersRecycled
        skipped = @($skipped.ToArray())
    } | ConvertTo-Json -Depth 8 -Compress))
    exit 0
}
catch {
    [Console]::Error.WriteLine($_.Exception.Message)
    exit 1
}
