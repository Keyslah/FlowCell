{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowCell",
  "version": "0.1.6",
  "identifier": "com.flowcell.frontend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FlowCell",
        "width": 1276,
        "height": 762,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msWebView2EnableMinimalWindow --autoplay-policy=no-user-gesture-required",
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false
  }
}
