# Generated release output.
dist/

flowcellbackend/local/

# Program-local button/layout state and durable private script copies.
Programs/*/Panels/**
Programs/*/* Local Scripts/**

# Deprecated/generated script locations kept out of Git.
Programs/*/* Active Scripts/**
Programs/Blender/Blender Scripts/**
Programs/Illustrator/Illustrator Scripts/**
Programs/Photoshop/Photoshop Scripts/**
Programs/Windows/Windows Scripts/**
Programs/*/ScriptBank/**
Programs/*/ManagedActions/**
Programs/*/**/__pycache__/**
*.pyc

# Do not track loose program-root scripts; use Git Scripts instead.
Programs/*/*.ahk
Programs/*/*.bat
Programs/*/*.cmd
Programs/*/*.js
Programs/*/*.jsx
Programs/*/*.py
Programs/*/*.ps1
Programs/*/*.vbs

# Loose/testing/old script dumps stay fully local.
Programs/*/[Ss]cript[Dd]ump/**

*.exe
*.dll
*.pdb
*.msi
*.zip
*.7z

bin/
obj/
.vs/

Thumbs.db
.DS_Store
